{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "parcimonia-local": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-I",
        "-B",
        "${PLUGIN_ROOT}/server.py"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  }
}
